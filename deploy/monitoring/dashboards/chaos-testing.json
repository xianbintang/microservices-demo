      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum by (namespace, label_app) (\n  kube_pod_status_ready{namespace=\"online-boutique\", condition=\"true\"}\n  * on(namespace, pod) group_left(label_app)\n  kube_pod_labels{namespace=\"online-boutique\"}\n)",
          "legendFormat": "{{label_app}}",
          "refId": "A"
