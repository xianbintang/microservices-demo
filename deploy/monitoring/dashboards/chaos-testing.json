          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "(\n  sum(rate(traces_spanmetrics_calls_total{service_name=~\".+\"}[5m])) by (service_name)\n  - sum(rate(traces_spanmetrics_calls_total{service_name=~\".+\", status_code=\"STATUS_CODE_OK\"}[5m])) by (service_name)\n) / sum(rate(traces_spanmetrics_calls_total{service_name=~\".+\"}[5m])) by (service_name)",
          "legendFormat": "{{service_name}}",
          "refId": "A"
