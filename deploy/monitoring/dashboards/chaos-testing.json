  },
  "description": "应用告警监控大盘 — 实时展示 Pod 健康、告警触发、性能影响与资源压力",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "refresh": "10s",
  "schemaVersion": 38,
  "tags": ["monitoring", "sre"],
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "应用告警监控",
  "uid": "app-monitoring-v1",
  "version": 1,
  "panels": [

    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "id": 100,
      "title": "告警概览",
      "type": "row"
    },

    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "fixed", "fixedColor": "red"},
          "custom": {
            "fillOpacity": 80,
            "hideFrom": {"legend": false, "tooltip": false, "viz": false},
            "lineWidth": 0,
            "spanNulls": false
          },
          "mappings": [
            {"options": {"0": {"color": "green", "index": 0, "text": "inactive"}, "1": {"color": "red", "index": 1, "text": "firing"}}, "type": "value"}
          ],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 1},
      "id": 20,
      "options": {
        "alignValue": "left",
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "mergeValues": true,
        "rowHeight": 0.9,
        "showValue": "auto",
        "tooltip": {"mode": "single", "sort": "none"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "ALERTS{alertname=~\"App.*\"} == 1",
          "legendFormat": "{{alertname}} [{{severity}}] {{pod}}{{label_app}}{{service_name}}",
          "refId": "A"
        }
      ],
      "title": "历史告警时间线 (时间窗口内)",
      "type": "state-timeline"
    },

    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"fixedColor": "red", "mode": "fixed"},
          "mappings": [{"options": {"0": {"color": "green", "index": 0, "text": "0"}}, "type": "value"}],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 8, "x": 0, "y": 9},
      "id": 1,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "count(ALERTS{alertname=~\"App.*\", severity=\"critical\", alertstate=\"firing\"}) or vector(0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Critical 告警",
      "type": "stat"
    },

    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"fixedColor": "orange", "mode": "fixed"},
          "mappings": [{"options": {"0": {"color": "green", "index": 0, "text": "0"}}, "type": "value"}],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}]},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 8, "x": 8, "y": 9},
      "id": 2,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "count(ALERTS{alertname=~\"App.*\", severity=\"warning\", alertstate=\"firing\"}) or vector(0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Warning 告警",
      "type": "stat"
    },

    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [{"options": {"0": {"color": "green", "index": 0, "text": "无告警"}}, "type": "value"}],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 8, "x": 16, "y": 9},
      "id": 3,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "count(ALERTS{alertname=~\"App.*\", alertstate=\"firing\"}) or vector(0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "活跃告警总数",
      "type": "stat"
    },

    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "custom": {"align": "left", "cellOptions": {"type": "auto"}, "filterable": true, "inspect": false},
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "alertname"},
            "properties": [{"id": "displayName", "value": "告警名称"}, {"id": "custom.width", "value": 220}]
          },
          {
            "matcher": {"id": "byName", "options": "severity"},
            "properties": [
              {"id": "displayName", "value": "严重级别"},
              {"id": "custom.width", "value": 100},
              {"id": "custom.cellOptions", "value": {"type": "color-background"}},
              {"id": "mappings", "value": [
                {"options": {"critical": {"color": "red", "index": 0}}, "type": "value"},
                {"options": {"warning": {"color": "orange", "index": 1}}, "type": "value"}
              ]}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "pod"},
            "properties": [{"id": "displayName", "value": "Pod"}, {"id": "custom.width", "value": 280}]
          },
          {
            "matcher": {"id": "byName", "options": "namespace"},
            "properties": [{"id": "displayName", "value": "命名空间"}, {"id": "custom.width", "value": 140}]
          },
          {
            "matcher": {"id": "byName", "options": "Value"},
            "properties": [{"id": "displayName", "value": "状态"}, {"id": "custom.width", "value": 80}]
          }
        ]
      },
      "gridPos": {"h": 7, "w": 24, "x": 0, "y": 13},
      "id": 4,
      "options": {
        "cellHeight": "sm",
        "footer": {"countRows": false, "fields": "", "reducer": ["sum"], "show": false},
        "showHeader": true,
        "sortBy": [{"desc": true, "displayName": "严重级别"}]
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "ALERTS{alertname=~\"App.*\", alertstate=\"firing\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "活跃告警详情",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {"Time": true, "__name__": true, "alertstate": true, "job": true, "prometheus": true, "prometheus_replica": true, "condition": true},
            "renameByName": {}
          }
        }
      ],
      "type": "table"
    },

    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 20},
      "id": 101,
      "title": "Pod 健康状态",
      "type": "row"
    },

    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
