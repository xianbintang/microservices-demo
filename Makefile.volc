# ===========================================
# 火山引擎 VKE 一键部署 Makefile
# ===========================================

SHELL := /bin/bash
.DEFAULT_GOAL := help

# 加载环境变量
-include .env.volc

# 默认值
REGISTRY ?= microservices-demo-cn-shanghai.cr.volces.com
NAMESPACE ?= microservices-demo/microservices-demo
IMAGE_TAG ?= v0.10.4
DEPLOY_NAMESPACE ?= online-boutique
APP_NAME ?= online-boutique

# 完整镜像仓库地址
IMAGE_REPO := $(REGISTRY)/$(NAMESPACE)

# 构建平台
PLATFORM := linux/amd64

# 容器运行时 (检测 docker 或 podman)
DOCKER := $(shell command -v docker 2>/dev/null || command -v podman 2>/dev/null)
ifeq ($(DOCKER),)
  $(error 未找到 docker 或 podman，请安装其中一个)
endif

# ===========================================
# 帮助信息
# ===========================================
.PHONY: help
help:
	@echo ""
	@echo "======================================"
	@echo "  火山引擎 VKE 部署工具"
	@echo "======================================"
	@echo ""
	@echo "【一键部署】"
	@echo "  make -f Makefile.volc all          # 构建+推送+部署"
	@echo ""
	@echo "【分步执行】"
	@echo "  make -f Makefile.volc check-env    # 检查环境"
	@echo "  make -f Makefile.volc build        # 构建所有镜像"
	@echo "  make -f Makefile.volc push         # 推送镜像到 CR"
	@echo "  make -f Makefile.volc deploy       # 部署到 VKE"
	@echo ""
	@echo "【状态查看】"
	@echo "  make -f Makefile.volc status       # 查看部署状态"
	@echo "  make -f Makefile.volc url          # 获取访问地址"
	@echo ""
	@echo "【监控栈管理】"
	@echo "  make -f Makefile.volc monitoring-deploy   # 部署监控栈"
	@echo "  make -f Makefile.volc monitoring-status   # 查看监控栈状态"
	@echo "  make -f Makefile.volc monitoring-url      # 获取 Grafana 地址"
	@echo "  make -f Makefile.volc monitoring-destroy  # 卸载监控栈"
	@echo ""
	@echo "【切换可观测性】"
	@echo "  make -f Makefile.volc switch-to-selfhosted  # 切换到自建监控"
	@echo ""

# ===========================================
# 环境检查
# ===========================================
.PHONY: check-env
check-env:
	@echo "检查环境依赖..."
	@command -v kubectl >/dev/null 2>&1 || { echo "❌ 未安装 kubectl"; exit 1; }
	@echo "✅ 容器运行时: $(DOCKER)"
	@echo "✅ kubectl 已安装"
	@echo ""
	@echo "检查 Kubernetes 连接..."
	@kubectl cluster-info >/dev/null 2>&1 && echo "✅ Kubernetes 连接正常" || { echo "❌ Kubernetes 连接失败"; exit 1; }
	@echo ""
	@echo "当前配置:"
	@echo "  镜像仓库: $(IMAGE_REPO)"
	@echo "  镜像版本: $(IMAGE_TAG)"
	@echo "  部署命名空间: $(DEPLOY_NAMESPACE)"

# ===========================================
# 构建所有镜像
# ===========================================
.PHONY: build
build:
	@echo "======================================"
	@echo "开始构建所有镜像..."
	@echo "======================================"
	@echo ""
	@echo ">>> 构建 emailservice"
	$(DOCKER) build --platform $(PLATFORM) -t $(IMAGE_REPO)/emailservice:$(IMAGE_TAG) -f src/emailservice/Dockerfile src/emailservice
	@echo ""
	@echo ">>> 构建 productcatalogservice"
	$(DOCKER) build --platform $(PLATFORM) -t $(IMAGE_REPO)/productcatalogservice:$(IMAGE_TAG) -f src/productcatalogservice/Dockerfile src/productcatalogservice
	@echo ""
	@echo ">>> 构建 recommendationservice"
	$(DOCKER) build --platform $(PLATFORM) -t $(IMAGE_REPO)/recommendationservice:$(IMAGE_TAG) -f src/recommendationservice/Dockerfile src/recommendationservice
	@echo ""
	@echo ">>> 构建 shippingservice"
	$(DOCKER) build --platform $(PLATFORM) -t $(IMAGE_REPO)/shippingservice:$(IMAGE_TAG) -f src/shippingservice/Dockerfile src/shippingservice
	@echo ""
	@echo ">>> 构建 checkoutservice"
	$(DOCKER) build --platform $(PLATFORM) -t $(IMAGE_REPO)/checkoutservice:$(IMAGE_TAG) -f src/checkoutservice/Dockerfile src/checkoutservice
	@echo ""
	@echo ">>> 构建 paymentservice"
	$(DOCKER) build --platform $(PLATFORM) -t $(IMAGE_REPO)/paymentservice:$(IMAGE_TAG) -f src/paymentservice/Dockerfile src/paymentservice
	@echo ""
	@echo ">>> 构建 currencyservice"
	$(DOCKER) build --platform $(PLATFORM) -t $(IMAGE_REPO)/currencyservice:$(IMAGE_TAG) -f src/currencyservice/Dockerfile src/currencyservice
	@echo ""
	@echo ">>> 构建 frontend"
	$(DOCKER) build --platform $(PLATFORM) -t $(IMAGE_REPO)/frontend:$(IMAGE_TAG) -f src/frontend/Dockerfile src/frontend
	@echo ""
	@echo ">>> 构建 loadgenerator"
	$(DOCKER) build --platform $(PLATFORM) -t $(IMAGE_REPO)/loadgenerator:$(IMAGE_TAG) -f src/loadgenerator/Dockerfile src/loadgenerator
	@echo ""
	@echo ">>> 构建 shoppingassistantservice"
	$(DOCKER) build --platform $(PLATFORM) -t $(IMAGE_REPO)/shoppingassistantservice:$(IMAGE_TAG) -f src/shoppingassistantservice/Dockerfile src/shoppingassistantservice
	@echo ""
	@echo "⚠️  cartservice 和 adservice 使用预构建镜像 (跨架构/网络限制)"
	@echo "✅ 所有本地镜像构建完成!"

# ===========================================
# 推送镜像
# ===========================================
.PHONY: push
push:
	@echo "推送镜像到 $(IMAGE_REPO)..."
	@echo ""
	@echo ">>> 推送 emailservice"
	$(DOCKER) push $(IMAGE_REPO)/emailservice:$(IMAGE_TAG)
	@echo ">>> 推送 productcatalogservice"
	$(DOCKER) push $(IMAGE_REPO)/productcatalogservice:$(IMAGE_TAG)
	@echo ">>> 推送 recommendationservice"
	$(DOCKER) push $(IMAGE_REPO)/recommendationservice:$(IMAGE_TAG)
	@echo ">>> 推送 shippingservice"
	$(DOCKER) push $(IMAGE_REPO)/shippingservice:$(IMAGE_TAG)
	@echo ">>> 推送 checkoutservice"
	$(DOCKER) push $(IMAGE_REPO)/checkoutservice:$(IMAGE_TAG)
	@echo ">>> 推送 paymentservice"
	$(DOCKER) push $(IMAGE_REPO)/paymentservice:$(IMAGE_TAG)
	@echo ">>> 推送 currencyservice"
	$(DOCKER) push $(IMAGE_REPO)/currencyservice:$(IMAGE_TAG)
	@echo ">>> 推送 frontend"
	$(DOCKER) push $(IMAGE_REPO)/frontend:$(IMAGE_TAG)
	@echo ">>> 推送 loadgenerator"
	$(DOCKER) push $(IMAGE_REPO)/loadgenerator:$(IMAGE_TAG)
	@echo ">>> 推送 shoppingassistantservice"
	$(DOCKER) push $(IMAGE_REPO)/shoppingassistantservice:$(IMAGE_TAG)
	@echo ""
	@echo "✅ 镜像推送完成!"
	@echo "⚠️  cartservice 和 adservice 使用 Google 预构建镜像"

# ===========================================
# 部署
# ===========================================
.PHONY: generate-values
generate-values:
	@echo "生成 Helm values 文件..."
	@mkdir -p deploy
	@printf "# 火山引擎 VKE 部署配置\n" > deploy/values-volc.yaml
	@printf "images:\n" >> deploy/values-volc.yaml
	@printf "  repository: $(IMAGE_REPO)\n" >> deploy/values-volc.yaml
	@printf "  tag: \"$(IMAGE_TAG)\"\n" >> deploy/values-volc.yaml
	@printf "\n" >> deploy/values-volc.yaml
	@printf "serviceAccounts:\n" >> deploy/values-volc.yaml
	@printf "  create: true\n" >> deploy/values-volc.yaml
	@printf "\n" >> deploy/values-volc.yaml
	@printf "opentelemetryCollector:\n" >> deploy/values-volc.yaml
	@printf "  create: false\n" >> deploy/values-volc.yaml
	@printf "\n" >> deploy/values-volc.yaml
	@printf "googleCloudOperations:\n" >> deploy/values-volc.yaml
	@printf "  profiler: false\n" >> deploy/values-volc.yaml
	@printf "  tracing: false\n" >> deploy/values-volc.yaml
	@printf "  metrics: false\n" >> deploy/values-volc.yaml
	@printf "\n" >> deploy/values-volc.yaml
	@printf "# 火山引擎 APM Plus 配置\n" >> deploy/values-volc.yaml
	@printf "volcengineAPM:\n" >> deploy/values-volc.yaml
	@printf "  enabled: true\n" >> deploy/values-volc.yaml
	@printf "  endpoint: \"apmplus-cn-beijing.ivolces.com:4317\"\n" >> deploy/values-volc.yaml
	@printf "  appKey: \"e775465d4a2c539b4bee69a6e98d9a67\"\n" >> deploy/values-volc.yaml
	@printf "  compression: gzip\n" >> deploy/values-volc.yaml
	@printf "  insecure: true\n" >> deploy/values-volc.yaml
	@printf "\n" >> deploy/values-volc.yaml
	@printf "frontend:\n" >> deploy/values-volc.yaml
	@printf "  create: true\n" >> deploy/values-volc.yaml
	@printf "  externalService: true\n" >> deploy/values-volc.yaml
	@printf "\n" >> deploy/values-volc.yaml
	@printf "loadGenerator:\n" >> deploy/values-volc.yaml
	@printf "  create: true\n" >> deploy/values-volc.yaml
	@printf "\n" >> deploy/values-volc.yaml
	@printf "cartDatabase:\n" >> deploy/values-volc.yaml
	@printf "  inClusterRedis:\n" >> deploy/values-volc.yaml
	@printf "    create: true\n" >> deploy/values-volc.yaml
	@echo "✅ 生成 deploy/values-volc.yaml"

.PHONY: deploy
deploy: generate-values
	@echo "部署到 Kubernetes..."
	kubectl create namespace $(DEPLOY_NAMESPACE) --dry-run=client -o yaml | kubectl apply -f -
	@echo ""
	@if [ -d "helm-chart" ]; then \
		echo "使用 Helm 部署..."; \
		helm upgrade --install $(APP_NAME) ./helm-chart \
			-f deploy/values-volc.yaml \
			-n $(DEPLOY_NAMESPACE) \
			--wait --timeout 10m; \
	else \
		echo "Helm chart 不存在，使用 kubectl 部署..."; \
		kubectl apply -f release/kubernetes-manifests.yaml -n $(DEPLOY_NAMESPACE); \
	fi
	@echo ""
	@echo "✅ 部署完成!"
	@$(MAKE) -f Makefile.volc url

.PHONY: undeploy
undeploy:
	@echo "删除部署..."
	-helm uninstall $(APP_NAME) -n $(DEPLOY_NAMESPACE) 2>/dev/null
	kubectl delete namespace $(DEPLOY_NAMESPACE) --ignore-not-found=true
	@echo "✅ 部署已删除"

# ===========================================
# 状态查看
# ===========================================
.PHONY: status
status:
	@echo "=== Pod 状态 ==="
	-kubectl get pods -n $(DEPLOY_NAMESPACE) -o wide 2>/dev/null || echo "命名空间不存在"
	@echo ""
	@echo "=== Service 状态 ==="
	-kubectl get svc -n $(DEPLOY_NAMESPACE) 2>/dev/null || true

.PHONY: logs
logs:
	kubectl logs -l app -n $(DEPLOY_NAMESPACE) --tail=100 -f --all-containers=true

.PHONY: url
url:
	@echo ""
	@echo "=== 前端访问地址 ==="
	@EXTERNAL_IP=$$(kubectl get svc frontend-external -n $(DEPLOY_NAMESPACE) -o jsonpath='{.status.loadBalancer.ingress[0].ip}' 2>/dev/null); \
	if [ -n "$$EXTERNAL_IP" ]; then \
		echo "http://$$EXTERNAL_IP"; \
	else \
		echo "等待 LoadBalancer 分配 IP..."; \
		kubectl get svc frontend-external -n $(DEPLOY_NAMESPACE) 2>/dev/null || echo "Service 不存在"; \
	fi

.PHONY: port-forward
port-forward:
	@echo "端口转发前端到 localhost:8080..."
	kubectl port-forward svc/frontend -n $(DEPLOY_NAMESPACE) 8080:80

# ===========================================
# 清理
# ===========================================
.PHONY: clean
clean:
	@echo "清理本地镜像..."
	-$(DOCKER) rmi $(IMAGE_REPO)/emailservice:$(IMAGE_TAG) 2>/dev/null || true
	-$(DOCKER) rmi $(IMAGE_REPO)/productcatalogservice:$(IMAGE_TAG) 2>/dev/null || true
	-$(DOCKER) rmi $(IMAGE_REPO)/recommendationservice:$(IMAGE_TAG) 2>/dev/null || true
	-$(DOCKER) rmi $(IMAGE_REPO)/shippingservice:$(IMAGE_TAG) 2>/dev/null || true
	-$(DOCKER) rmi $(IMAGE_REPO)/checkoutservice:$(IMAGE_TAG) 2>/dev/null || true
	-$(DOCKER) rmi $(IMAGE_REPO)/paymentservice:$(IMAGE_TAG) 2>/dev/null || true
	-$(DOCKER) rmi $(IMAGE_REPO)/currencyservice:$(IMAGE_TAG) 2>/dev/null || true
	-$(DOCKER) rmi $(IMAGE_REPO)/cartservice:$(IMAGE_TAG) 2>/dev/null || true
	-$(DOCKER) rmi $(IMAGE_REPO)/frontend:$(IMAGE_TAG) 2>/dev/null || true
	-$(DOCKER) rmi $(IMAGE_REPO)/adservice:$(IMAGE_TAG) 2>/dev/null || true
	-$(DOCKER) rmi $(IMAGE_REPO)/loadgenerator:$(IMAGE_TAG) 2>/dev/null || true
	-$(DOCKER) rmi $(IMAGE_REPO)/shoppingassistantservice:$(IMAGE_TAG) 2>/dev/null || true
	@echo "✅ 清理完成"

# ===========================================
# 一键完整部署
# ===========================================
.PHONY: all
all: check-env build push deploy

# ===========================================
# 监控栈管理
# ===========================================
MONITORING_NAMESPACE ?= monitoring
KUBE_PROM_STACK_VERSION := 65.5.0
LOKI_VERSION := 6.6.2
TEMPO_VERSION := 1.10.3

.PHONY: monitoring-setup
monitoring-setup:
	@echo "初始化 Helm 仓库..."
	-helm repo add prometheus-community https://prometheus-community.github.io/helm-charts 2>/dev/null || true
	-helm repo add grafana https://grafana.github.io/helm-charts 2>/dev/null || true
	helm repo update
	@echo "✅ Helm 仓库配置完成"

.PHONY: monitoring-deploy
monitoring-deploy: monitoring-setup
	@echo "======================================"
	@echo "部署自建可观测性栈..."
	@echo "======================================"
	@echo ""
	@echo "创建 monitoring namespace..."
	kubectl create namespace $(MONITORING_NAMESPACE) --dry-run=client -o yaml | kubectl apply -f -
	@echo ""
	@echo "部署 kube-prometheus-stack..."
	helm upgrade --install kube-prometheus-stack prometheus-community/kube-prometheus-stack \
		-n $(MONITORING_NAMESPACE) \
		-f deploy/monitoring/kube-prometheus-stack-values.yaml \
		--version $(KUBE_PROM_STACK_VERSION) \
		--wait --timeout 15m
	@echo ""
	@echo "部署 Loki..."
	helm upgrade --install loki grafana/loki \
		-n $(MONITORING_NAMESPACE) \
		-f deploy/monitoring/loki-values.yaml \
		--version $(LOKI_VERSION) \
		--wait --timeout 10m
	@echo ""
	@echo "部署 Promtail..."
	helm upgrade --install promtail grafana/promtail \
		-n $(MONITORING_NAMESPACE) \
		-f deploy/monitoring/promtail-values.yaml \
		--wait --timeout 5m
	@echo ""
	@echo "部署 Tempo..."
	helm upgrade --install tempo grafana/tempo \
		-n $(MONITORING_NAMESPACE) \
		-f deploy/monitoring/tempo-values.yaml \
		--version $(TEMPO_VERSION) \
		--wait --timeout 5m
	@echo ""
	@echo "应用告警规则..."
	kubectl apply -f deploy/monitoring/alerting/ -n $(MONITORING_NAMESPACE)
	@echo ""
	@echo "✅ 监控栈部署完成!"
	@$(MAKE) -f Makefile.volc monitoring-url

.PHONY: monitoring-url
monitoring-url:
	@echo ""
	@echo "=== Grafana 访问地址 ==="
	@GRAFANA_IP=$$(kubectl get svc kube-prometheus-stack-grafana \
		-n $(MONITORING_NAMESPACE) \
		-o jsonpath='{.status.loadBalancer.ingress[0].ip}' 2>/dev/null); \
	if [ -n "$$GRAFANA_IP" ]; then \
		echo "Grafana: http://$$GRAFANA_IP"; \
		echo "默认账号: admin / admin"; \
	else \
		echo "等待 Grafana LoadBalancer IP 分配..."; \
		kubectl get svc kube-prometheus-stack-grafana -n $(MONITORING_NAMESPACE); \
	fi

.PHONY: monitoring-status
monitoring-status:
	@echo "=== 监控栈 Pod 状态 ==="
	kubectl get pods -n $(MONITORING_NAMESPACE) -o wide
	@echo ""
	@echo "=== 监控栈 Service 状态 ==="
	kubectl get svc -n $(MONITORING_NAMESPACE)

.PHONY: monitoring-logs
monitoring-logs:
	kubectl logs -l app.kubernetes.io/name=prometheus -n $(MONITORING_NAMESPACE) --tail=100 -f

.PHONY: monitoring-destroy
monitoring-destroy:
	@echo "卸载监控栈..."
	-helm uninstall tempo -n $(MONITORING_NAMESPACE) 2>/dev/null || true
	-helm uninstall promtail -n $(MONITORING_NAMESPACE) 2>/dev/null || true
	-helm uninstall loki -n $(MONITORING_NAMESPACE) 2>/dev/null || true
	-helm uninstall kube-prometheus-stack -n $(MONITORING_NAMESPACE) 2>/dev/null || true
	-helm uninstall dingtalk-webhook -n $(MONITORING_NAMESPACE) 2>/dev/null || true
	@echo ""
	@echo "监控栈已卸载"
	@echo "如需删除 namespace，执行: kubectl delete ns $(MONITORING_NAMESPACE)"

# ===========================================
# 切换到自建可观测性栈
# ===========================================
.PHONY: switch-to-selfhosted
switch-to-selfhosted:
	@echo "切换到自建可观测性栈..."
	@if [ -f "deploy/values-volc.yaml" ]; then \
		sed -i.bak 's/volcengineAPM:.*/volcengineAPM:\n  enabled: false/' deploy/values-volc.yaml 2>/dev/null || \
		sed -i '' 's/volcengineAPM:.*/volcengineAPM:\
  enabled: false/' deploy/values-volc.yaml; \
		echo "" >> deploy/values-volc.yaml; \
		echo "selfHostedObservability:" >> deploy/values-volc.yaml; \
		echo "  enabled: true" >> deploy/values-volc.yaml; \
		echo "已更新 deploy/values-volc.yaml"; \
		echo "请执行: make -f Makefile.volc deploy"; \
	else \
		echo "❌ deploy/values-volc.yaml 不存在，请先执行 make -f Makefile.volc generate-values"; \
	fi