# ===========================================
# 火山引擎 VKE 部署配置
# ===========================================

# ---------- 镜像仓库配置 ----------
# 你的镜像仓库地址
# 镜像格式: {REGISTRY}/{NAMESPACE}/{服务名}:{IMAGE_TAG}
# 示例: microservices-demo-cn-shanghai.cr.volces.com/microservices-demo/microservices-demo/frontend:v0.10.4
REGISTRY=microservices-demo-cn-shanghai.cr.volces.com
NAMESPACE=microservices-demo/microservices-demo

# 镜像版本
IMAGE_TAG=v0.10.4

# ---------- Kubernetes 集群配置 ----------
# 部署的命名空间
DEPLOY_NAMESPACE=online-boutique

# 应用名称
APP_NAME=online-boutique